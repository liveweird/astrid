# Local playground only. Copy to .env; never commit real credentials.
POSTGRES_PASSWORD=astrid-local-development
POSTGRES_CONNECT_RETRIES=10
ASTRID_INSPECTOR_ENABLED=false
# Optional: generate with `openssl rand -hex 32`; enter in the inspector UI.
ASTRID_INSPECTOR_KEY=
# Optional listen address for a native `./gradlew :server:run` (defaults: 127.0.0.1, 8088).
# The container binds 0.0.0.0:8088 and Compose publishes it on loopback; these do not change that.
# A non-default port also moves the default allowed hosts/origins; set ASTRID_ALLOWED_HOSTS and
# ASTRID_ALLOWED_ORIGINS explicitly behind a proxy.
# ASTRID_BIND_HOST=127.0.0.1
# ASTRID_PORT=8088
